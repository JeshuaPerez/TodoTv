# Puerto de la API. Ojo: la interfaz de frontend/ usa el 4000 y las dos corren a la vez,
# así que si lo cambiás acá, ajustá también API_DESTINO en frontend/.
PUERTO=3000
ENTORNO=desarrollo

# Atlas: mongodb+srv://usuario:clave@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/
MONGO_BASE=todotv

JWT_SECRETO=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRACION=2h
COOKIE_NOMBRE=todotv_token

# Versión que expone la API para la negociación con semver
API_VERSION=1.0.0
